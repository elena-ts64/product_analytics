          <mxGeometry height="60" width="90" x="470" y="360" as="geometry" />
        </mxCell>
        <mxCell id="wk2a-dth2Q-64pLuFPv0-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Кол-во просмотров товара" vertex="1">
          <mxGeometry height="60" width="80" x="580" y="360" as="geometry" />
        </mxCell>
        <mxCell id="wk2a-dth2Q-64pLuFPv0-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="SLA" vertex="1">
          <mxGeometry height="60" width="61" x="670" y="360" as="geometry" />
        </mxCell>
        <mxCell id="wk2a-dth2Q-64pLuFPv0-29" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;b&gt;Конверсия в заказ&lt;/b&gt; = Кол-во заказов / Кол-во просмотров&lt;br&gt;&lt;br&gt;&lt;b&gt;DAU &lt;/b&gt;-&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;количество уникальных активных пользователей&amp;nbsp;за день. Чем больше активных пользователей, тем больше будет заказов.&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;text-align: center;&quot;&gt;&lt;b&gt;Кол-во пользователей&lt;/b&gt; - общее кол-во пользователей с установленным приложением. Чем больше пользователей, тем больше может быть активных пользователей.&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;text-align: center;&quot;&gt;&lt;b&gt;Rolling retention&lt;/b&gt; -&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-indent: -0.5cm; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;% пользователей от изначального&amp;nbsp;количества, которые продолжают&amp;nbsp;пользоваться продуктом спустя N дней&amp;nbsp;после своего первого касания. Для отслеживания неоднократного использования приложения.&lt;/span&gt;&lt;span style=&quot;text-align: center;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;text-align: center;&quot;&gt;&lt;b&gt;Return retention&lt;/b&gt; -&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-indent: -0.5cm; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;% пользователей от изначального&amp;nbsp;количества, которые пользовались&amp;nbsp;продуктом хотя бы 1 раз за N дней после&amp;nbsp;своего первого касания. Для отслеживания регулярности использования приложения пользователем за период.&lt;/span&gt;&lt;span style=&quot;text-align: center;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;text-align: center;&quot;&gt;&lt;b&gt;Конверсия в активного пользователя&lt;/b&gt; = Кол-во активных пользователей / Кол-во зарегестрированных&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;text-align: center;&quot;&gt;&lt;b&gt;Кол-во регистраций&lt;/b&gt; - кол-во зарегестрированных пользователей.&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;text-align: center;&quot;&gt;&lt;b&gt;Конверсия установок в регистрации&lt;/b&gt; = Кол-во регистраций в приложении / Кол-во установленных приложений пользователями&lt;br&gt;&lt;br&gt;&lt;b&gt;Средняя длительность сессии&lt;/b&gt; - средняя длительность использования приложения. Чем дольше пользуются, тем выше вероятнсть заказа.&lt;br&gt;&lt;b&gt;Кол-во просмотров товара&lt;/b&gt; - среднее кол-во просмотренных товаров одним пользователем.&lt;br&gt;&lt;b&gt;SLA&lt;/b&gt;, % =&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;(Общее время − Время простоя) / Общее время. Отслеживание времени доступности сервиса&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="750" x="40" y="480" as="geometry" />
        </mxCell>
        <mxCell id="wk2a-dth2Q-64pLuFPv0-30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Return retention" vertex="1">
          <mxGeometry height="60" width="61" x="300" y="360" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
