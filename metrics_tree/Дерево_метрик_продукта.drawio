        <mxCell id="wk2a-dth2Q-64pLuFPv0-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Кол-во регистраций" vertex="1">
